# E5: the USB gadget's netdevs -- usb0 and usb1, one per network function
# (RNDIS, CDC-ECM; see /opt/e5/gadget-guard.sh and /usr/sbin/e5-usb-mode) --
# join br-lan here, not through netifd.  netifd owns an empty bridge
# (bridge_empty, 90-e5) and these netdevs are in no configuration of its:
# adding a port to a bridge, or taking it out, leaves the port's link alone.
#
# They are also brought up here: a gadget interface that is merely present but
# down enumerates, looks configured from the host side and carries nothing.
# Nothing here ever takes one of them down -- the vendor NCM function used to
# panic the kernel when it was downed and refed (docs/FINDINGS.md 28).
[ "$ACTION" = ifup ] && [ "$INTERFACE" = lan ] || exit 0
[ -e /sys/class/net/br-lan ] || exit 0
for d in /sys/class/net/usb*; do
	[ -e "$d" ] || continue
	n=${d##*/}
	# nothing may keep an address of its own on a bridge port
	ip -4 addr flush dev "$n"
	echo 1 > /proc/sys/net/ipv6/conf/$n/disable_ipv6
	ip link set "$n" up
	[ -e /sys/class/net/br-lan/brif/$n ] || ip link set "$n" master br-lan
	logger -t e5 "$n up, in br-lan"
done
