#!/bin/sh /etc/rc.common
# Read-only ModemManager property mirror. No modem commands or radio control.
START=30
STOP=10
USE_PROCD=1
start_service() {
    procd_open_instance
    procd_set_param command /usr/libexec/e5-background /usr/libexec/e5-mm-state
    procd_set_param respawn 3600 5 0
    procd_set_param stderr 1
    procd_close_instance
}
